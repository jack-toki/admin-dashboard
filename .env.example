# Supabase (Project settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...service_role...

# Google Sheet published as CSV (File -> Share -> Publish to web -> CSV)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv

# Shared secret the Zap webhook sends as header x-toki-secret
INGEST_SECRET=change-me-to-something-random

# URL slug -> display label (must match the Account column in your sheet)
ACCOUNTS={"house-to-home":"House to Home Surveys","interim-digital":"Interim Digital"}

# Cockpit sign-in. The dashboard fails closed when these are unset.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Optional separate password for the personal JRL area only.
# JRL_PASSWORD=

# Optional opaque key -> one client name. That session cannot read Toki finances or JRL.
# CLIENT_ACCESS_KEYS={"example-key":"Example Client"}

# Read-only Google service account JSON. Share the workbook with that account as Viewer.
# Do not publish the sheet. Do not put the JSON in git.
GOOGLE_SERVICE_ACCOUNT_JSON=
FORECAST_SPREADSHEET_ID=
PROFILES_SHEET_ID=

# Standard Xero OAuth web app. Not a custom connection. 32-byte key, base64.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_TOKEN_ENCRYPTION_KEY=

# Read-only ClickUp token for workspace 20571424 list 901211242918. Not an agent session.
CLICKUP_API_TOKEN=
